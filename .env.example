# Copy this file to .env. Keep .env local and never commit or paste its values into chat.
JOB_FINDER_CONFIG=config/settings.example.toml

# OpenAI Responses API. Create the key in an approved OpenAI API project.
OPENAI_API_KEY=

# H8 recommended policy: efficient focused classification with Structured Outputs.
JOB_FINDER_LLM_MODEL=gpt-6-luna
JOB_FINDER_LLM_REASONING_EFFORT=low
# Increment whenever model/reasoning behavior is intentionally changed.
JOB_FINDER_LLM_POLICY_VERSION=1
JOB_FINDER_LLM_TIMEOUT_SECONDS=30

# Per-run hard ceilings. At current published GPT-6 Luna standard token prices, exhausting
# 1,000,000 input plus 100,000 output tokens is approximately USD 0.15 before taxes or premiums.
JOB_FINDER_LLM_MAX_REQUESTS=500
JOB_FINDER_LLM_MAX_ESTIMATED_INPUT_TOKENS=1000000
JOB_FINDER_LLM_MAX_OUTPUT_TOKENS=100000
JOB_FINDER_LLM_MAX_OUTPUT_TOKENS_PER_REQUEST=300
