# Copy this file to .env. Keep .env local and never commit or paste its values into chat.
JOB_FINDER_CONFIG=config/settings.example.toml

# AMD Unified LLM gateway. Obtain the key through the approved corporate process.
LLM_GATEWAY_KEY=

# H8 recommended gateway model for focused classification.
JOB_FINDER_LLM_MODEL=gpt-5.6-luna
# Increment whenever model or request behavior is intentionally changed.
JOB_FINDER_LLM_POLICY_VERSION=1
JOB_FINDER_LLM_TIMEOUT_SECONDS=30

# Per-run hard request and token ceilings. Corporate gateway pricing/chargeback is not assumed.
JOB_FINDER_LLM_MAX_REQUESTS=500
JOB_FINDER_LLM_MAX_ESTIMATED_INPUT_TOKENS=1000000
JOB_FINDER_LLM_MAX_OUTPUT_TOKENS=100000
JOB_FINDER_LLM_MAX_OUTPUT_TOKENS_PER_REQUEST=300
