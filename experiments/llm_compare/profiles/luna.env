# Overrides loaded on top of JOB_Finder/.env for the Luna run. No secrets here.
# gpt-6-luna OpenAI list price (Standard, short context) as of 2026-10-02.
JOB_FINDER_LLM_MODEL=gpt-6-luna
JOB_FINDER_LLM_INPUT_COST_PER_MTOK=0.10
JOB_FINDER_LLM_CACHED_INPUT_COST_PER_MTOK=0.01
JOB_FINDER_LLM_CACHE_WRITE_COST_PER_MTOK=0.125
JOB_FINDER_LLM_OUTPUT_COST_PER_MTOK=0.50
# Pipeline runs (run_compare.sh) ask twice and break gate ties with a third call, ~2.05
# calls per job. The caps must cover that: on 2026-10-03 a 7,000-request cap halted the
# run 207 jobs short. The lab harness ignores these and keeps one answer per call.
JOB_FINDER_LLM_SECOND_OPINION=true
JOB_FINDER_LLM_MAX_REQUESTS=12000
JOB_FINDER_LLM_MAX_ESTIMATED_INPUT_TOKENS=100000000
JOB_FINDER_LLM_MAX_OUTPUT_TOKENS=20000000
