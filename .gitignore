# Local environments and secrets
.venv/
.env
.env.*
!.env.example

# Python build and tool caches
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Local application state and generated artifacts
/state/*
!/state/.gitkeep
/reports/*
!/reports/.gitkeep
/diagnostics/
/browser-captures/
/http-cache/
/llm-output/

# LLM comparison experiments: code, prompts, verdicts and report are tracked; run
# databases, frozen description copies, raw replies and logs are large and local only.
/experiments/llm_compare/runs/
/experiments/llm_compare/scratch/
/experiments/llm_compare/lab/cases*.json
/experiments/llm_compare/lab/results*/
# Generated by casebook/build_review.py (~1 MB of job descriptions); rebuild any time.
/experiments/llm_compare/casebook/review.html
# Generated by lab/build_label_review.py from the git-ignored cases file.
/experiments/llm_compare/lab/label_review.html

# Pre-existing local build and provenance material
/.artifact_build/
/.codex_tmp/
/outputs/

# Private notes (not for the repo)
/PS_Note.md

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
